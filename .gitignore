# secrets & credentials — NEVER commit tokens
scripts/creds/token_*
**/kaggle.json
*.env

# caches & build output
__pycache__/
node_modules/
*.pyc
.part
*.log

# large local data (restored via scripts/download_heavy_assets.py)
data/aurum_v2_features.parquet
data/phase1/
models/
backup/

# v2.1 heavy binary outputs (>25MB) — GitHub Release v2.1.0 / Kaggle only;
# SHA-256 manifest for every heavy asset lives in scripts/download_heavy_assets.py
artifacts/v2_1/**/*.parquet
artifacts/v2_1/**/*.pt
artifacts/v2_1/**/*.tar.gz
*.parquet.tmp
